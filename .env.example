# ─────────────────────────────────────────────────────────────
# Copie ce fichier en .env et remplis tes clés.
# ─────────────────────────────────────────────────────────────

# --- Choix du modèle d'embeddings (couche agnostique) ---
# Valeurs possibles : mistral | openai | cohere
EMBEDDING_PROVIDER=mistral

# Mistral (https://console.mistral.ai/)
MISTRAL_API_KEY=
MISTRAL_EMBED_MODEL=mistral-embed

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-large

# Cohere (https://dashboard.cohere.com/)
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-multilingual-v3.0

# --- Pinecone (https://app.pinecone.io/) ---
PINECONE_API_KEY=
PINECONE_INDEX=dictionnaire-vivant-tome1
# Namespace dédié au Tome 1 (isole nos vecteurs si l'index est partagé)
PINECONE_NAMESPACE=tome1
# Région du serverless (gratuit par défaut sur AWS us-east-1)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
