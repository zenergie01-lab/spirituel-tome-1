# ─────────────────────────────────────────────────────────────
# Secrets pour Streamlit Cloud (format TOML).
#
# NE PAS committer le vrai fichier secrets.toml (il est dans .gitignore).
# Sur Streamlit Cloud : copie ce contenu (avec tes vraies clés) dans
#   Manage app → Settings → Secrets
# ─────────────────────────────────────────────────────────────

EMBEDDING_PROVIDER = "mistral"

MISTRAL_API_KEY = "ta-cle-mistral"
MISTRAL_EMBED_MODEL = "mistral-embed"

# (optionnel, seulement si tu changes de fournisseur)
# OPENAI_API_KEY = "ta-cle-openai"
# OPENAI_EMBED_MODEL = "text-embedding-3-large"
# COHERE_API_KEY = "ta-cle-cohere"
# COHERE_EMBED_MODEL = "embed-multilingual-v3.0"

PINECONE_API_KEY = "ta-cle-pinecone"
PINECONE_INDEX = "taodesmots"
PINECONE_NAMESPACE = "tome1"
PINECONE_CLOUD = "aws"
PINECONE_REGION = "us-east-1"
